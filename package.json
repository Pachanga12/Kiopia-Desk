{
  "name": "kopia-desk",
  "version": "3.0.0",
  "description": "Kopia Desk v3: copias de seguridad incrementales para Windows, con copia verificada y copias cifradas con contraseña",
  "homepage": "https://github.com/Pachanga12/Kopia-Desk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pachanga12/Kopia-Desk.git"
  },
  "bugs": {
    "url": "https://github.com/Pachanga12/Kopia-Desk/issues"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "lint": "node --check main.js && node --check preload.js && node --check lib/core.js && node --check lib/cifrado.js && node --check lib/almacen.js && node --check renderer/compare.js && node --check renderer/restore-tree.js && node --check renderer/tutorial.js && node --check renderer/app.js",
    "build": "node scripts/build.js"
  },
  "author": "Pachanga12",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kopiadesk.app",
    "productName": "Kopia Desk v3",
    "win": {
      "target": "nsis",
      "icon": "assets/Kopia_Desk_icon.png"
    },
    "asarUnpack": [
      "lib/eject-drive.ps1",
      "lib/Recuperar-KopiaDesk.ps1"
    ],
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "license": "build/licencia.txt",
      "include": "build/installer.nsh",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Kopia Desk v3",
      "uninstallDisplayName": "Kopia Desk v3",
      "deleteAppDataOnUninstall": false,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp"
    }
  }
}
